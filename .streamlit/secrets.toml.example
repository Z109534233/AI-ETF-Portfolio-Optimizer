# Example only -- copy to .streamlit/secrets.toml (already git-ignored) for
# local testing, or paste the equivalent into your hosting platform's
# "Secrets" UI (e.g. Streamlit Community Cloud). NEVER commit real values.
#
# See AUTH.md for the full Google Cloud Console setup steps.

[auth]
redirect_uri = "https://ai-etf-portfolio.streamlit.app/oauth2callback"
cookie_secret = "replace-with-a-long-random-locally-generated-string"
client_id = "replace-with-your-google-oauth-client-id"
client_secret = "replace-with-your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
